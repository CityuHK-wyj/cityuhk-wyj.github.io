  "artifact_runtime_direction": {
    "information_transfer": {
      "pattern": "fixed_envelope_flexible_payload_explicit_references",
      "reference_targets": [
        "user_message",
        "query_span",
        "conversation_message",
        "artifact",
        "artifact_field_or_row",
        "web_evidence_span",
        "knowledge_item",
        "sql_result",
        "derived_computation",
        "clarification_answer"
      ]
    },
    "planner": {
      "role": "artifact_dataflow_planner",
      "loop": [
        "understand_goal",
        "identify_missing_need",
        "select_capability",
        "produce_or_consume_artifact",
        "assess_scope_and_evidence",
        "replan_until_sufficient_or_terminal"
      ]
    },
    "tool_composition": [
      "web_to_sql",
      "sql_to_web",
      "knowledge_to_sql",
      "sql_to_compute_to_web",
      "web_to_entity_to_sql",
      "db_anomaly_to_web_to_db_reanalysis"
    ],
    "artifact": {
      "planned_fields": [
        "artifact_id",
        "kind",
        "structured_data",
        "text_content",
        "exports",
        "provenance",
        "references",
        "actual_scope",
        "lineage",
        "metadata"
      ]
    },
    "scope_and_sufficiency": {
      "distinguish": ["requested_scope", "actual_scope"],
      "coverage_dimensions": [
        "entity",
        "time",
        "population",
        "measure",
        "evidence_quality"
      ],
      "complete_rule": "core_goal_supported_by_relevant_accepted_evidence"
    }
  },
